{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (macOS)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "macos",
      "args": [
        "--dart-define-from-file=.env.local"
      ],
      "env": {
        "FLUTTER_TEST_DEVICE": "macos"
      }
    },
    {
      "name": "Flutter (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=.env.local",
        "--web-port=8080"
      ],
      "env": {
        "FLUTTER_TEST_DEVICE": "chrome"
      }
    },
    {
      "name": "Flutter (iPhone Simulator)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "iphone",
      "args": [
        "--dart-define-from-file=.env.local"
      ],
      "env": {
        "FLUTTER_TEST_DEVICE": "ios"
      }
    },
    {
      "name": "Flutter (iPad Simulator)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "ipad",
      "args": [
        "--dart-define-from-file=.env.local"
      ],
      "env": {
        "FLUTTER_TEST_DEVICE": "ios"
      }
    }
  ]
}