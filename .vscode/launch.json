{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (any)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": [
        "--dart-define-from-file=.env.local"
      ]
    },
    {
      "name": "Flutter (macOS)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "macos",
      "args": [
        "--dart-define-from-file=.env.local"
      ]
    },
    {
      "name": "Flutter (Windows)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "windows",
      "args": [
        "--dart-define-from-file=.env.local"
      ]
    },
    {
      "name": "Flutter (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=.env.local",
        "--web-port=8080"
      ]
    }
  ]
}